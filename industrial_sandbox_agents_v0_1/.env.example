APP_TIMEZONE=America/Santiago
EVENT_BUS_BACKEND=redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_DECODE_RESPONSES=true
REDIS_STREAM_PREFIX=
EVENT_INPUT_STREAM=enriched.correlation.stream
EVENT_OUTPUT_STREAM=context_slice
REDIS_DOCKER_CONTAINER=queue-broker
REDIS_CONSUMER_START_ID=$
REDIS_BLOCK_MS=5000
CONTEXT_REPORT_PATH=/app/reports/context_slices.jsonl
CONTEXT_HEARTBEAT_PATH=/tmp/context_engine_heartbeat
AGENT_MODE=read_only
