{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ContextSliceV0_1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "primary_service",
    "related_services",
    "topology_summary",
    "propagation_summary",
    "token_budget"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "event_id": {"type": "string"},
    "primary_service": {"type": "string"},
    "related_services": {"type": "array", "items": {"type": "string"}},
    "topology_summary": {"type": "string"},
    "propagation_summary": {"type": "string"},
    "recent_anomalies": {"type": "array", "items": {"type": "object"}},
    "runbook_refs": {"type": "array", "items": {"type": "string"}},
    "policy_refs": {"type": "array", "items": {"type": "string"}},
    "token_budget": {
      "type": "object",
      "required": ["max_tokens", "estimated_tokens"],
      "properties": {
        "max_tokens": {"type": "integer"},
        "estimated_tokens": {"type": "integer"}
      }
    }
  }
}
