{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "enriched_anomaly_event_v0_1.json",
  "title": "enriched_anomaly_event_v0_1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "timestamp",
    "source",
    "services_observed",
    "primary_service",
    "iforest_scores",
    "iforest_labels",
    "correlation_engine",
    "severity_preliminary",
    "evidence_refs",
    "raw_event_refs"
  ],
  "properties": {
    "schema_version": {
      "const": "enriched_anomaly_event_v0_1"
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "services_observed": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "primary_service": {
      "type": "string",
      "minLength": 1
    },
    "iforest_scores": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "number"
      }
    },
    "iforest_labels": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "enum": [
          "normal",
          "anomalous"
        ]
      }
    },
    "correlation_engine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "model",
        "propagation_signature_id",
        "propagation_detected",
        "lag_pattern_seconds",
        "confidence"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "propagation_signature_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "propagation_detected": {
          "type": "boolean"
        },
        "lag_pattern_seconds": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        }
      }
    },
    "window_data_quality_score": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "severity_preliminary": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "raw_event_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
