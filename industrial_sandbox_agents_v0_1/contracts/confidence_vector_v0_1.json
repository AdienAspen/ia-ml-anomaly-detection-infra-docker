{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "confidence_vector_v0_1.json",
  "title": "confidence_vector_v0_1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "confidence_score",
    "evidence_strength",
    "retrieval_quality",
    "tool_success_rate",
    "model_uncertainty",
    "policy_status",
    "human_review_required",
    "reason",
    "conflicting_signals",
    "missing_context"
  ],
  "properties": {
    "schema_version": {
      "const": "confidence_vector_v0_1"
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "confidence_score": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "evidence_strength": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "retrieval_quality": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "tool_success_rate": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "model_uncertainty": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "policy_status": {
      "type": "string",
      "enum": ["pass", "warning", "blocked"]
    },
    "human_review_required": {
      "type": "boolean"
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "conflicting_signals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "missing_context": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
