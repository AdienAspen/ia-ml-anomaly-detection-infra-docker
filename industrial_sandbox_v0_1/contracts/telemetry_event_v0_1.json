{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TelemetryEventV0_1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "generated_at",
    "source_node",
    "service_name",
    "cpu_pct",
    "memory_pct",
    "latency_ms",
    "disk_io_pct",
    "net_error_rate",
    "queue_length",
    "throughput_rate",
    "http_5xx_rate",
    "status_code",
    "is_synthetic",
    "scenario_tag",
    "telemetry_profile"
  ],
  "properties": {
    "event_id": { "type": "string" },
    "generated_at": { "type": "string", "format": "date-time" },
    "source_node": { "type": "string" },
    "service_name": {
      "type": "string",
      "enum": ["payments-api", "orders-api", "checkout-api"]
    },
    "cpu_pct": { "type": "number", "minimum": 0, "maximum": 100 },
    "memory_pct": { "type": "number", "minimum": 0, "maximum": 100 },
    "latency_ms": { "type": "number", "minimum": 0 },
    "disk_io_pct": { "type": "number", "minimum": 0, "maximum": 100 },
    "net_error_rate": { "type": "number", "minimum": 0 },
    "queue_length": { "type": "number", "minimum": 0 },
    "throughput_rate": { "type": "number", "minimum": 0 },
    "http_5xx_rate": { "type": "number", "minimum": 0 },
    "status_code": { "type": "integer", "minimum": 100, "maximum": 599 },
    "is_synthetic": { "type": "boolean" },
    "scenario_tag": {
      "type": "string",
      "enum": ["normal", "anomalous"]
    },
    "telemetry_profile": {
      "type": "string",
      "enum": ["simple", "market_aware_v1"]
    }
  }
}
