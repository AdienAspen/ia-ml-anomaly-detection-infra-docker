{
  "title": "IForest Detector Policy Contract v1",
  "type": "object",
  "required": [
    "schema_version",
    "policy_name",
    "policy_version",
    "runtime_mode",
    "model_path",
    "scoring_policy",
    "threshold_mode",
    "threshold_by_service",
    "min_flag_window",
    "expected_features",
    "validation_summary",
    "promoted_from",
    "promoted_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "policy_name": {
      "type": "string"
    },
    "policy_version": {
      "type": "string"
    },
    "runtime_mode": {
      "type": "string",
      "enum": [
        "shadow",
        "active"
      ]
    },
    "model_path": {
      "type": "string"
    },
    "scoring_policy": {
      "type": "string",
      "enum": [
        "score_samples"
      ]
    },
    "threshold_mode": {
      "type": "string",
      "enum": [
        "service_specific"
      ]
    },
    "threshold_by_service": {
      "type": "object",
      "required": [
        "checkout-api",
        "orders-api",
        "payments-api"
      ],
      "properties": {
        "checkout-api": {
          "type": "number"
        },
        "orders-api": {
          "type": "number"
        },
        "payments-api": {
          "type": "number"
        }
      }
    },
    "min_flag_window": {
      "type": "integer",
      "minimum": 1
    },
    "expected_features": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "string"
      }
    },
    "validation_summary": {
      "type": "object",
      "required": [
        "true_positive_rate_on_anomalous",
        "false_positive_rate_on_normal",
        "service_flag_rate_span",
        "burst_proxy_flag_rate",
        "late_drift_flag_rate"
      ],
      "properties": {
        "true_positive_rate_on_anomalous": {
          "type": "number"
        },
        "false_positive_rate_on_normal": {
          "type": "number"
        },
        "service_flag_rate_span": {
          "type": "number"
        },
        "burst_proxy_flag_rate": {
          "type": "number"
        },
        "late_drift_flag_rate": {
          "type": "number"
        }
      }
    },
    "promoted_from": {
      "type": "object",
      "required": [
        "block",
        "model_package",
        "decision_diagnostics_report",
        "shadow_report"
      ],
      "properties": {
        "block": {
          "type": "string"
        },
        "model_package": {
          "type": "string"
        },
        "decision_diagnostics_report": {
          "type": "string"
        },
        "shadow_report": {
          "type": "string"
        }
      }
    },
    "promoted_at": {
      "type": "string"
    }
  }
}
