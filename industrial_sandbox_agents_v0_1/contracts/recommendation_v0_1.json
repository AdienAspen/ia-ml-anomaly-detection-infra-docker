{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "recommendation_v0_1.json",
  "title": "recommendation_v0_1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "recommendation_type",
    "priority",
    "recommendation_text",
    "requires_human_approval"
  ],
  "properties": {
    "schema_version": {
      "const": "recommendation_v0_1"
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "recommendation_type": {
      "type": "string",
      "enum": ["observe", "investigate", "escalate"]
    },
    "priority": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"]
    },
    "recommendation_text": {
      "type": "string",
      "minLength": 1
    },
    "requires_human_approval": {
      "type": "boolean"
    }
  }
}
